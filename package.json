{
  "name": "@softistx/pulsarix-widget",
  "version": "0.5.0",
  "type": "module",
  "description": "Embeddable client-issue intake widget for pulsarix, rendered in a Shadow DOM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softistx/pulsarix-widget.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "restricted"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^7.0.1",
    "@happy-dom/global-registrator": "^21.0.4",
    "@softistx/material": "^3.273.3",
    "@softistx/material-core": "^0.96.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^17.1.0",
    "playwright-core": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome ci",
    "fix": "biome check --write",
    "typecheck": "bun check",
    "test": "bun test",
    "size": "bun scripts/check-size.ts",
    "check:deps": "bun scripts/check-deps.ts",
    "generate": "bun scripts/generate.ts",
    "generate:check": "bun scripts/generate.ts --check",
    "schema:sync": "bun scripts/schema-sync.ts",
    "schema:check": "bun scripts/schema-sync.ts --check",
    "test:browser": "bun scripts/leak-test.ts && bun scripts/screenshot-test.ts && bun scripts/files-test.ts && bun scripts/thread-test.ts && bun scripts/privacy-test.ts",
    "fixture": "bun scripts/serve-fixture.ts",
    "verify": "bun run lint && bun run schema:check && bun run generate:check && bun run build && bun run typecheck && bun run test && bun run check:deps && bun run size",
    "release": "bun scripts/publish.ts",
    "capture": "bun scripts/capture.ts",
    "capture:theme": "bun scripts/capture-theme.ts",
    "capture:requests": "bun scripts/capture-requests.ts",
    "capture:thread": "bun scripts/capture-thread.ts",
    "capture:privacy": "bun scripts/capture-privacy.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/types/index.d.ts",
    "dist/types/config.d.ts",
    "dist/types/element.d.ts",
    "dist/types/mount.d.ts",
    "dist/server.js",
    "dist/types/server.d.ts",
    "docs/integration.md"
  ],
  "types": "./dist/types/index.d.ts",
  "sideEffects": true
}
